# If your password contains special characters (e.g. '@'), URL-encode them: '@' -> '%40'
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/vehicle_service

# --- Agents ---
# true = in-memory mock data, false = call the FastAPI backend at API_BASE_URL
USE_MOCK_TOOLS=true
API_BASE_URL=http://localhost:8000
# Vehicle Operations Agent (Member 3): LLM loop for free-form requests (auto = on when OPENAI_API_KEY is set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
VEHICLE_AGENT_LLM=auto
