{
    "model_name": "fleetflow_maintenance_risk_model",
    "model_version": "2.0.0",
    "algorithm": "LogisticRegression",
    "feature_count": 13,
    "features": [
        "mileage",
        "vehicle_age",
        "days_until_next_service",
        "total_services",
        "pending_services",
        "in_progress_services",
        "completed_services",
        "total_cost",
        "service_cost",
        "parts_cost",
        "fuel_cost",
        "cost_last_30_days",
        "cost_last_90_days"
    ],
    "training_rows": 10,
    "target": "active_maintenance_requirement",
    "target_definition": "1 if the vehicle currently has a pending or in-progress service, otherwise 0",
    "training_type": "development_prototype",
    "warning": "This model is trained on the current FleetFlow seed data. It is not a validated future-maintenance prediction model.",
    "training_date": "2026-10-20"
}